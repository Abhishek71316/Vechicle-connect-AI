# RoadGuardian AI - Environment Variables Example
# Copy this file to .env and fill in your actual values

DATABASE_URL=sqlite:///./roadguardian.db
WS_HOST=0.0.0.0
WS_PORT=8000

DROWSINESS_THRESHOLD=0.7
DISTRACTION_THRESHOLD=0.6
ACCIDENT_COUNTDOWN_SECONDS=30

GEMINI_API_KEY=

# TextBee SMS Configuration
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Emergency contacts - India
EMERGENCY_CONTACT_1=91XXXXXXXXXX
EMERGENCY_CONTACT_2=91XXXXXXXXXX

ACCIDENT_SMS_COOLDOWN_MS=300000
