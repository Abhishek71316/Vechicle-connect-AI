# Smart Vehicle Connect AI - Environment Variables Example
# Copy this file to .env and fill in your values

# -------------------------------------------------------------
# Google Gemini AI Configuration
# -------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# -------------------------------------------------------------
# Google Cloud Text-to-Speech (TTS) Configuration
# (For high-fidelity Kannada Chirp 3 HD / WaveNet natural voices)
# -------------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# -------------------------------------------------------------
# TextBee SMS Emergency Dispatch Configuration
# -------------------------------------------------------------
TEXTBEE_API_KEY=txb_your_api_key
TEXTBEE_DEVICE_ID=your_device_id

# Emergency Family Member Phone Numbers (Format: 91XXXXXXXXXX or +91XXXXXXXXXX)
EMERGENCY_CONTACT_1=91XXXXXXXXXX
EMERGENCY_CONTACT_2=91XXXXXXXXXX

# -------------------------------------------------------------
# Optional Safety Configuration
# -------------------------------------------------------------
ACCIDENT_SMS_COOLDOWN_MS=300000
PORT=5000
